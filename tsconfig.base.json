{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "target": "es2022",
    "jsx": "react-jsx",
    "skipLibCheck": true
  }
}
