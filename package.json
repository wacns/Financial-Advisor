{
  "name": "financial-advisor",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "tsc -p desktop/tsconfig.policy.json",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:oauth": "playwright test --config playwright.auth.config.ts",
    "start": "expo start --dev-client",
    "native:android": "expo run:android",
    "native:ios": "expo run:ios",
    "native:prebuild": "expo prebuild",
    "build:native": "expo export --platform android --platform ios --output-dir dist-native",
    "lint": "npm run typecheck && eslint .",
    "predev": "node scripts/prepare-ocr.ts",
    "prebuild": "node scripts/prepare-ocr.ts",
    "desktop:prepare": "node scripts/prepare-desktop.ts",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop:start": "npm run desktop:prepare && electron desktop",
    "desktop:build": "npm run desktop:prepare && electron-builder --config electron-builder.config.ts --publish never",
    "test:desktop": "node scripts/test-desktop.ts",
    "typecheck": "tsc -p desktop/tsconfig.policy.json && tsc -p tsconfig.web.json && tsc -p tsconfig.native.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "2.118.0",
    "@tesseract.js-data/eng": "1.0.0",
    "expo": "58.0.19",
    "expo-build-properties": "58.0.11",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.15",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.11",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.14",
    "expo-local-authentication": "58.0.2",
    "expo-notifications": "58.1.6",
    "expo-screen-capture": "58.0.6",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.20",
    "expo-system-ui": "58.0.6",
    "expo-updates": "58.0.18",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "main": "native-entry.ts",
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "xcode": {
      "uuid": "11.1.1"
    },
    "eslint-plugin-react-hooks": {
      "zod": "4.6.7"
    }
  }
}
