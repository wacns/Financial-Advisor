{
  "name": "financial-advisor",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:oauth": "playwright test --config playwright.auth.config.js",
    "native:sync": "npm run build:native && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios",
    "native:doctor": "cap doctor",
    "build:native": "node scripts/check-native.mjs && vite build --mode native"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@ionic/core": "9.0.8",
    "@supabase/supabase-js": "2.118.0",
    "firebase": "12.19.0",
    "lucide": "1.57.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  }
}
